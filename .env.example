# Salin ke .env.local (lokal) dan isi juga di Vercel → Project → Settings → Environment Variables.
# Ambil dari Supabase → Project Settings → API Keys / Data API.
# Kunci publishable/anon aman ada di browser (data dilindungi RLS).
# JANGAN pernah menaruh service_role / secret key di sini.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
